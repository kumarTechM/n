test("multiple window handling",async()=>
{
    const browser = await chromium.launch({ headless: false });

    // Create browser context
    const context = await browser.newContext();

    // Open parent page
    const page = await context.newPage();

    await page.goto('https://the-internet.herokuapp.com/windows');

    console.log('Parent Window Title:', await page.title());

    // Click link that opens a new window
    const [childPage] = await Promise.all([
        context.waitForEvent('page'),
        page.locator('text=Click Here').click()
    ]);

    // Wait for child page to load
    await childPage.waitForLoadState();

    console.log('Child Window Title:', await childPage.title());
      // Get all open pages/windows
    const pages = context.pages();

    console.log('Total Windows Opened:', pages.length);

    // Iterate through all windows
    for (const currentPage of pages) {

        await currentPage.waitForLoadState();

        const title = await currentPage.title();
        console.log('Window Title:', title);

        // Perform action on specific window
        if (title === 'New Window') {

            await currentPage.bringToFront();//brings the specified tab/window to the foreground (makes it the active tab) in the browser.
// if you haven;t mentioned above line still it will work 
            const text = await currentPage.locator('h3').textContent();

            console.log('Text in Child Window:', text);

            expect(text).toBe('New Window');
        }
    }

    // Close child window
    await childPage.close();

    // Switch back to parent window
    await page.bringToFront();

    console.log('Back to Parent Window:', await page.title());
      // Validate parent page
    await expect(page.locator('h3')).toHaveText('Opening a new window');

    // Close browser
    await browser.close();

})

